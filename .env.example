PORT=5050
NODE_ENV=development

# ── Gemini AI (Google) ────────────────────────────────────────────────────────
# Get a FREE key at https://aistudio.google.com/app/apikey
# Without this key the chatbot uses a smart rule-based fallback automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# ── YouTube Data API ──────────────────────────────────────────────────────────
# Get a key at https://console.cloud.google.com/apis/credentials
# Without this key, video search falls back to hardcoded sample videos.
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change this to any long random string in production
JWT_SECRET=change_me_in_production_use_a_long_random_string
